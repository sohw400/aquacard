{
  "name": "aqua-card-poc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "build:pages": "tsc --noEmit && vite build --base=/aquacard/",
    "preview": "vite preview --host 0.0.0.0 --port 4173 --strictPort",
    "preview:pages": "vite preview --host 0.0.0.0 --port 4173 --strictPort --base=/aquacard/",
    "test": "tsx --test src/lib/*.test.ts",
    "test:browser": "node scripts/browser-check.mjs",
    "test:devices": "node scripts/device-check.mjs",
    "audit:screens": "node scripts/screen-audit.mjs",
    "dev:server": "VITE_DATA_MODE=server vite --host 0.0.0.0 --port 5173 --strictPort",
    "server:dev": "node --env-file-if-exists=.env --watch --import tsx server/index.ts",
    "server:start": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "server:credit": "node --env-file-if-exists=.env --import tsx server/credit.ts",
    "server:card": "node --env-file-if-exists=.env --import tsx server/card.ts",
    "server:card:ops": "node --env-file-if-exists=.env --import tsx server/card-operations-operator.ts",
    "server:inbox": "node --env-file-if-exists=.env --import tsx server/card-inbox-operator.ts",
    "server:card:ingress": "node --env-file-if-exists=.env --import tsx server/card-ingress.ts",
    "server:card:worker": "node --env-file-if-exists=.env --import tsx server/card-worker.ts",
    "server:issuer": "node --env-file-if-exists=.env --import tsx server/issuer-operator.ts",
    "server:issuer:dispatch": "node --env-file-if-exists=.env --import tsx server/issuer-dispatcher.ts",
    "server:rewards": "node --env-file-if-exists=.env --import tsx server/rewards-operator.ts",
    "server:reconcile:statement": "node --env-file-if-exists=.env --import tsx server/reconcile-issuer-statement.ts",
    "server:reconcile": "node --env-file-if-exists=.env --import tsx server/reconcile-rewards.ts",
    "server:monitor": "node --env-file-if-exists=.env --import tsx server/operations-monitor.ts",
    "build:server": "npm run typecheck:server && node scripts/build-server.mjs",
    "build:connected": "tsc --noEmit && VITE_DATA_MODE=server vite build",
    "test:server": "node --env-file-if-exists=.env --import tsx --test server/*.test.ts",
    "test:recovery": "bash scripts/recovery-drill.sh",
    "test:pitr": "bash scripts/pitr-drill.sh",
    "test:server:browser": "node scripts/server-browser-check.mjs",
    "test:card:browser": "node scripts/card-browser-check.mjs",
    "test:rewards:browser": "node scripts/rewards-browser-check.mjs",
    "test:issuer:browser": "node --env-file-if-exists=.env --import tsx scripts/issuer-browser-runner.mjs",
    "server:prod": "node dist-server/index.js",
    "server:credit:prod": "node dist-server/credit.js",
    "typecheck:server": "tsc --noEmit -p tsconfig.server.json",
    "db:migrate": "node --env-file-if-exists=.env --import tsx server/migrate.ts",
    "db:migrate:prod": "node dist-server/migrate.js",
    "server:customer:access": "node --env-file-if-exists=.env --import tsx server/customer-access-operator.ts",
    "test:security:browser": "node --env-file-if-exists=.env --import tsx scripts/security-browser-runner.mjs",
    "server:mail:worker": "node --env-file-if-exists=.env --import tsx server/auth-mail-worker.ts",
    "test:email:browser": "node --env-file-if-exists=.env --import tsx scripts/email-browser-runner.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "3.1178.0",
    "@fastify/cookie": "11.1.5",
    "@fastify/static": "10.1.11",
    "@fastify/swagger": "9.9.4",
    "fastify": "5.12.8",
    "lucide-react": "1.55.0",
    "pg": "8.23.1",
    "pretendard": "1.3.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.170.0",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.170.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "playwright-core": "1.64.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
