# Local development only. Production secrets belong in the deployment secret manager.
DATABASE_URL=postgresql://aqua_app:aqua_app_local_only@127.0.0.1:54329/aqua
MIGRATION_DATABASE_URL=postgresql://aqua:aqua_local_only@127.0.0.1:54329/aqua
TEST_DATABASE_URL=postgresql://aqua:aqua_local_only@127.0.0.1:54329/aqua
DATABASE_SCHEMA=aqua
DATABASE_POOL_SIZE=10
DATABASE_RUNTIME_ROLE=aqua_app
# MIGRATION_DATABASE_URL uses a separate migration role in deployed environments.
# DATABASE_CA_FILE=/run/secrets/postgresql-ca.pem
AQUA_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AQUA_HOST=127.0.0.1
AQUA_PORT=3001
AQUA_MAIL_DIR=data/mail
# AQUA_TRUSTED_PROXIES=10.0.1.0/24,10.0.2.0/24
