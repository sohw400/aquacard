# Local development only. Production secrets belong in the deployment secret manager.
DATABASE_URL=postgresql://aqua_app:aqua_app_local_only@127.0.0.1:54329/aqua
MIGRATION_DATABASE_URL=postgresql://aqua:aqua_local_only@127.0.0.1:54329/aqua
TEST_DATABASE_URL=postgresql://aqua:aqua_local_only@127.0.0.1:54329/aqua
DATABASE_SCHEMA=aqua
DATABASE_POOL_SIZE=10
DATABASE_RUNTIME_ROLE=aqua_app
DATABASE_WORKER_ROLE=aqua_worker
DATABASE_INGRESS_ROLE=aqua_ingress
INGRESS_DATABASE_URL=postgresql://aqua_ingress:aqua_ingress_local_only@127.0.0.1:54329/aqua
WORKER_DATABASE_URL=postgresql://aqua_worker:aqua_worker_local_only@127.0.0.1:54329/aqua
DATABASE_DISPATCHER_ROLE=aqua_dispatcher
DISPATCHER_DATABASE_URL=postgresql://aqua_dispatcher:aqua_dispatcher_local_only@127.0.0.1:54329/aqua
DATABASE_OPERATIONS_ROLE=aqua_operations
OPERATIONS_DATABASE_URL=postgresql://aqua_operations:aqua_operations_local_only@127.0.0.1:54329/aqua
DATABASE_AUTH_MAIL_ROLE=aqua_auth_mail
AUTH_MAIL_DATABASE_URL=postgresql://aqua_auth_mail:aqua_auth_mail_local_only@127.0.0.1:54329/aqua
# Email verification/recovery require a separate encrypted queue and worker.
# Generate your own 32-byte base64 key; no shared development key is provided.
# AQUA_AUTH_MAIL_KEYS={"local":"<32 random bytes encoded as base64>"}
# AQUA_AUTH_MAIL_ACTIVE_KEY=local
# AQUA_AUTH_MAIL_TRANSPORT=file
# AQUA_AUTH_MAIL_POLL_MS=1000
# Production uses the SES worker, AWS task-role credentials and a verified sender.
# AQUA_AUTH_MAIL_TRANSPORT=ses
# AWS_REGION=ap-northeast-2
# AQUA_AUTH_MAIL_FROM=accounts@example.com
# AQUA_AUTH_MAIL_SES_CONFIGURATION_SET=aqua-auth
# Optional outbound issuer sandbox. This is not a live issuer API.
# AQUA_ISSUER_SANDBOX_URL=http://127.0.0.1:3005
# AQUA_ISSUER_KEY_ID=local
# AQUA_ISSUER_SIGNING_KEY=<32 random bytes encoded as base64url>
# AQUA_ISSUER_POLL_MS=1000
# Optional sandbox webhook receiver. No default signing key is provided.
# AQUA_CARD_WEBHOOK_KEYS={"local":"<32 random bytes encoded as base64url>"}
# AQUA_CARD_INGRESS_HOST=127.0.0.1
# AQUA_CARD_INGRESS_PORT=3004
# AQUA_CARD_WORKER_POLL_MS=1000
# MIGRATION_DATABASE_URL uses a separate migration role in deployed environments.
# DATABASE_CA_FILE=/run/secrets/postgresql-ca.pem
AQUA_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AQUA_HOST=127.0.0.1
AQUA_PORT=3001
AQUA_MAIL_DIR=data/mail
# AQUA_TRUSTED_PROXIES=10.0.1.0/24,10.0.2.0/24
